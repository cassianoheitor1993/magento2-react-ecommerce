type Query {
    blogPosts: BlogPostsOutput @resolver(class: "Petshop\\Blog\\Model\\Resolver\\BlogPosts") @doc(description: "Get all blog posts")
}

type BlogPostsOutput {
    items: [BlogPost] @doc(description: "List of blog posts")
}

type BlogPost {
    post_id: Int @doc(description: "Blog post ID")
    title: String @doc(description: "Blog post title")
    slug: String @doc(description: "Blog post slug")
    excerpt: String @doc(description: "Blog post summary")
    content: String @doc(description: "Blog post content")
    author: String @doc(description: "Blog post author")
    tags: String @doc(description: "Comma-separated tags")
    is_published: Int @doc(description: "Publication status")
    created_at: String @doc(description: "Creation date")
    updated_at: String @doc(description: "Last update date")
}
