<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">petshop_marketing_campaign_listing.petshop_marketing_campaign_listing_data_source</item>
			<item name="deps" xsi:type="string">petshop_marketing_campaign_listing.petshop_marketing_campaign_listing_data_source</item>
		</item>
		<item name="spinner" xsi:type="string">campaign_columns</item>
		<item name="buttons" xsi:type="array">
			<item name="add" xsi:type="array">
				<item name="name" xsi:type="string">add</item>
				<item name="label" xsi:type="string" translate="true">New Campaign</item>
				<item name="class" xsi:type="string">primary</item>
				<item name="url" xsi:type="string">*/*/new</item>
			</item>
		</item>
	</argument>

	<dataSource name="petshop_marketing_campaign_listing_data_source" component="Magento_Ui/js/grid/provider">
		<settings>
			<updateUrl path="mui/index/render"/>
		</settings>
		<dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
					  name="petshop_marketing_campaign_listing_data_source">
			<settings>
				<requestFieldName>campaign_id</requestFieldName>
				<primaryFieldName>campaign_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>

	<listingToolbar name="listing_top">
		<bookmark name="bookmarks"/>
		<columnsControls name="columns_controls"/>
		<filters name="listing_filters"/>
		<paging name="listing_paging"/>
	</listingToolbar>

	<columns name="campaign_columns">
		<selectionsColumn name="ids">
			<settings>
				<indexField>campaign_id</indexField>
			</settings>
		</selectionsColumn>

		<column name="campaign_id">
			<settings>
				<label translate="true">ID</label>
				<sorting>asc</sorting>
				<filter>textRange</filter>
			</settings>
		</column>

		<column name="name">
			<settings>
				<label translate="true">Name</label>
				<filter>text</filter>
			</settings>
		</column>

		<column name="status">
			<settings>
				<label translate="true">Status</label>
				<filter>select</filter>
			</settings>
		</column>

		<column name="subject">
			<settings>
				<label translate="true">Subject</label>
				<filter>text</filter>
			</settings>
		</column>

		<column name="total_recipients">
			<settings>
				<label translate="true">Total</label>
				<filter>textRange</filter>
			</settings>
		</column>

		<column name="sent_count">
			<settings>
				<label translate="true">Sent</label>
				<filter>textRange</filter>
			</settings>
		</column>

		<column name="failed_count">
			<settings>
				<label translate="true">Failed</label>
				<filter>textRange</filter>
			</settings>
		</column>

		<column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date">
			<settings>
				<label translate="true">Created At</label>
				<filter>dateRange</filter>
				<dataType>date</dataType>
			</settings>
		</column>

		<actionsColumn name="actions" class="Petshop\Marketing\Ui\Component\Listing\Column\CampaignActions">
			<settings>
				<indexField>campaign_id</indexField>
				<label translate="true">Actions</label>
			</settings>
		</actionsColumn>
	</columns>
</listing>
