<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Petshop\Homepage\Api\WidgetRepositoryInterface"
                type="Petshop\Homepage\Model\WidgetRepository"/>

    <virtualType name="Petshop\Homepage\Model\ResourceModel\Widget\Grid\ListingSearchResult"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">petshop_homepage_widget</argument>
            <argument name="resourceModel" xsi:type="string">Petshop\Homepage\Model\ResourceModel\Widget</argument>
            <argument name="identifierName" xsi:type="string">widget_id</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="petshop_homepage_widget_listing_data_source" xsi:type="string">Petshop\Homepage\Model\ResourceModel\Widget\Grid\ListingSearchResult</item>
            </argument>
        </arguments>
    </type>
</config>
