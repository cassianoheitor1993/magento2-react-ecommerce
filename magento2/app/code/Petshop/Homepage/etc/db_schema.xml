<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="petshop_homepage_widget" resource="default" engine="innodb" comment="Petshop Homepage Widgets">
        <column xsi:type="int" name="widget_id" unsigned="true" nullable="false" identity="true" comment="Widget ID"/>
        <column xsi:type="varchar" name="page_code" length="64" nullable="false" default="home" comment="Page Code"/>
        <column xsi:type="varchar" name="placement" length="64" nullable="false" default="middle" comment="Placement"/>
        <column xsi:type="varchar" name="widget_type" length="64" nullable="false" comment="Widget Type"/>
        <column xsi:type="varchar" name="title" length="255" nullable="false" comment="Widget Title"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="int" name="sort_order" nullable="false" default="10" comment="Sort Order"/>
        <column xsi:type="timestamp" name="starts_at" nullable="true" comment="Starts At"/>
        <column xsi:type="timestamp" name="ends_at" nullable="true" comment="Ends At"/>
        <column xsi:type="text" name="config_json" nullable="true" comment="Widget Config JSON"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="widget_id"/>
        </constraint>

        <index referenceId="PETSHOP_HOMEPAGE_WIDGET_PAGE_PLACEMENT" indexType="btree">
            <column name="page_code"/>
            <column name="placement"/>
        </index>

        <index referenceId="PETSHOP_HOMEPAGE_WIDGET_SORT_ORDER" indexType="btree">
            <column name="sort_order"/>
        </index>
    </table>
</schema>
