<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">leispet_homepage_widget_listing.leispet_homepage_widget_listing_data_source</item>
            <item name="deps" xsi:type="string">leispet_homepage_widget_listing.leispet_homepage_widget_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">widget_columns</item>
    </argument>

    <dataSource name="leispet_homepage_widget_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">widget_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="leispet_homepage_widget_listing_data_source">
            <settings>
                <requestFieldName>widget_id</requestFieldName>
                <primaryFieldName>widget_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="widget_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>widget_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="widget_id">
            <settings>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="title">
            <settings>
                <label translate="true">Title</label>
                <filter>text</filter>
            </settings>
        </column>

        <column name="widget_type">
            <settings>
                <label translate="true">Widget Type</label>
                <filter>text</filter>
            </settings>
        </column>

        <column name="sort_order">
            <settings>
                <label translate="true">Sort Order</label>
                <filter>textRange</filter>
            </settings>
        </column>

        <column name="starts_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <label translate="true">Visible From</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>

        <column name="ends_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <label translate="true">Visible Until</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>

        <column name="is_active">
            <settings>
                <label translate="true">Active</label>
                <dataType>select</dataType>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
            </settings>
        </column>

        <actionsColumn name="actions" class="LeisPet\Homepage\Ui\Component\Listing\Column\WidgetActions">
            <settings>
                <indexField>widget_id</indexField>
                <label translate="true">Actions</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
